{
  "name": "@onescm/server",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "release": "tsx scripts/release.ts",
    "traceability": "tsx scripts/traceability.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "lint": "eslint src scripts test",
    "backup": "tsx src/cli.ts backup",
    "restore": "tsx src/cli.ts restore",
    "perf": "tsx scripts/perf-import.ts",
    "perf:semantic": "tsx scripts/perf-semantic.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "better-sqlite3": "^11.10.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.3.2",
    "jose": "^6.2.12",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.3",
    "marked": "^18.0.14",
    "nodemailer": "^10.0.10",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "turndown": "^7.2.4",
    "uuid": "^11.1.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.11.0",
    "s3rver": "^3.7.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.1.3"
  }
}
